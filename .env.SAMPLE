# USRP parameters
USRP_BIND=127.0.0.1
USRP_HOST=127.0.0.1
USRP_RXPORT=34011
USRP_TXPORT=32011

# Zello credentials
ZELLO_USERNAME=<Zello_Username>
ZELLO_PASSWORD=<Zello_Password>
ZELLO_CHANNEL="<Zello Channel>"

# Zello Free variables
ZELLO_PRIVATE_KEY=test.key
ZELLO_ISSUER_ID=test.id
ZELLO_WS_ENDPOINT=wss://zello.io/ws

# Zello Work variables
#ZELLO_API_ENDPOINT=https://mynetwork.zellowork.com
#ZELLO_WS_ENDPOINT=wss://zellowork.io/ws/mynetwork

# Logging parameters
LOG_LEVEL=DEBUG
LOG_FORMAT="%(asctime)s | %(levelname)s | %(name)s | %(message)s"
LOG_DIR=/var/log/zello_bridge

# Audio parameters
USRP_GAIN_RX_DB=0
USRP_GAIN_TX_DB=0
